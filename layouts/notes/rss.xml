{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Notes — {{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Description }}</description>
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{ range first 50 .RegularPages.ByDate.Reverse }}
    <item>
      <title>{{ partial "notes/label.html" . }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="true">{{ .Permalink }}</guid>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      {{ range .Params.categories }}<category>{{ . }}</category>{{ end }}
      {{ $body := .Content }}
      {{ if eq .Params.kind "link" }}
        {{ $source := printf "<p><a href=\"%s\">%s ↗</a> (original source)</p>" (.Params.source_url | htmlEscape) ((partial "notes/label.html" .) | htmlEscape) }}
        {{ $body = printf "%s%s" $source $body }}
      {{ end }}
      <description>{{ $body | html }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
